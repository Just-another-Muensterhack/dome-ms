# cache dirs
UV_CACHE_DIR=/workspaces/.cache/uv
RUFF_CACHE_DIR=/workspaces/.cache/ruff
MYPY_CACHE_DIR=/workspaces/.cache/mypy
PRE_COMMIT_HOME=/workspaces/.cache/pre-commit

# Postgres
POSTGRES_HOST = "postgres"
POSTGRES_PORT = "5432"
POSTGRES_USER = "msdome"
POSTGRES_PASSWORD = "msdome"
POSTGRES_DB = "msdome"

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
# Backchannel URL (python container) and public URL (browser)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=msdome
KEYCLOAK_CLIENT_ID=msdome-backend
KEYCLOAK_CLIENT_SECRET=msdome-secret

# python
PYTHONPATH=service/src/ms_dome
DJANGO_SETTINGS_MODULE=ms_dome.settings

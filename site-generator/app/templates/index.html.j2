{% extends "_base.html.j2" %}
{% block description %}{{ c.meta_beschreibung }}{% endblock %}
{% block nav %}
<nav class="kopf__nav" aria-label="Hauptnavigation">
  {% for k in kapitel %}<a href="#{{ k.id }}">{{ k.titel }}</a>{% endfor %}
  <a class="kopf__cta" href="#kontakt">Kontakt</a>
</nav>
{% endblock %}
{% block inhalt %}

{# ------------------------------------------------------------------ Hero #}
<section class="hero zone-hero{% if bilder %} hero--mit-bild{% endif %}">
  <div class="bahn">
    <div class="hero__kopf">
      <p class="kicker">{{ kategorie_label or req.name }}</p>
      {% if req.ort %}<p class="kicker">{{ req.ort }}</p>{% endif %}
    </div>
    <div class="regel"></div>
    <div class="hero__raster">
      <h1 class="hero__titel">
        {% for z in hero_zeilen %}<span class="zeile"><span>{{ z }}</span></span>{% endfor %}
      </h1>
      {% if bilder %}
      <figure class="hero__bild bild-rahmen"><img src="{{ bilder[0].src }}" alt="{{ bilder[0].alt }}" fetchpriority="high"></figure>
      {% endif %}
      <div class="hero__unten">
        <div class="auftritt">
          <p class="intro">{{ c.hero.unterzeile }}</p>
          <div class="aktionen">
            <a class="aktion" href="#kontakt">{{ c.hero.cta_text }} <span class="pfeil" aria-hidden="true">→</span></a>
            {% if kapitel %}<a class="aktion aktion--still" href="#{{ kapitel[0].id }}">Mehr erfahren</a>{% endif %}
          </div>
        </div>
        {% if schild %}
        <dl class="typenschild auftritt">
          {% for k, v in schild %}<div><dt>{{ k }}</dt><dd>{{ v }}</dd></div>{% endfor %}
        </dl>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------ Laufband (nur modern) #}
{% if stil == "modern" and req.angebote %}
<div class="laufband" aria-hidden="true">
  <div class="laufband__spur">
    {% for _ in range(2) %}{% for a in req.angebote %}<span>{{ a }}</span><span class="stern">✳</span>{% endfor %}{% endfor %}
  </div>
</div>
{% endif %}

{# ------------------------------------------------------------- Kapitel #}
{% for k in kapitel %}
<section class="kapitel art-{{ k.art }} zone-hell" id="{{ k.id }}">
  <div class="bahn">
    <div class="kapitel__marke">
      <span class="nummer">{{ k.nr }}</span>
      <span class="kicker">{{ k.titel }}</span>
      <span class="regel"></span>
    </div>

    {% if k.art == "these" %}
      <div class="these-raster">
        <p class="these auftritt">{{ k.lead or k.titel }}</p>
        <div class="fliess auftritt">{% for a in k.absaetze %}<p>{{ a }}</p>{% endfor %}</div>
        {% if bilder|length > 1 %}<figure class="these__bild bild-rahmen auftritt"><img src="{{ bilder[1].src }}" alt="{{ bilder[1].alt }}" loading="lazy"></figure>{% endif %}
      </div>

    {% elif k.art == "liste" %}
      <div class="kapitel__kopf">
        <h2 class="auftritt">{{ k.lead or k.titel }}</h2>
        {% if k.absaetze %}<div class="fliess auftritt">{% for a in k.absaetze %}<p>{{ a }}</p>{% endfor %}</div>{% endif %}
      </div>
      <div class="liste">
        {% for p in k.punkte %}
        <article class="eintrag auftritt">
          <span class="nummer">{{ "%02d"|format(loop.index) }}</span>
          <h3>{{ p.titel }}</h3>
          <p>{{ p.text }}</p>
        </article>
        {% endfor %}
      </div>

    {% elif k.art == "zeiten" %}
      <div class="kapitel__kopf">
        <h2 class="auftritt">{{ k.lead or k.titel }}</h2>
        {% if k.absaetze %}<div class="fliess auftritt">{% for a in k.absaetze %}<p>{{ a }}</p>{% endfor %}</div>{% endif %}
      </div>
      <dl class="zeitplan auftritt">
        {% for wann, was in plan %}<div><dt>{{ wann }}</dt><dd>{{ was }}</dd></div>{% endfor %}
      </dl>

    {% else %}
      <div class="kapitel__kopf">
        <h2 class="auftritt">{{ k.lead or k.titel }}</h2>
        {% if k.absaetze %}<div class="fliess auftritt">{% for a in k.absaetze %}<p>{{ a }}</p>{% endfor %}</div>{% endif %}
      </div>
      {% if k.punkte %}
      <ol class="schritte">
        {% for p in k.punkte %}
        <li class="auftritt"><span class="nummer">{{ "%02d"|format(loop.index) }}</span><h3>{{ p.titel }}</h3><p>{{ p.text }}</p></li>
        {% endfor %}
      </ol>
      {% endif %}
    {% endif %}
  </div>
</section>
{% endfor %}

{# ------------------------------------------------------------- Galerie #}
{% if galerie %}
<section class="kapitel zone-hell" id="eindruecke">
  <div class="bahn">
    <div class="kapitel__marke">
      <span class="nummer">{{ "%02d"|format(kapitel|length + 1) }}</span>
      <span class="kicker">Eindrücke</span>
      <span class="regel"></span>
    </div>
    <div class="galerie galerie--{{ galerie|length }}">
      {% for b in galerie %}
      <figure class="bild-rahmen auftritt"><img src="{{ b.src }}" alt="{{ b.alt }}" loading="lazy">{% if not b.alt.startswith("Bild ") %}<figcaption>{{ b.alt }}</figcaption>{% endif %}</figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ---------------------------------------------------------------- FAQ #}
{% if c.faq %}
<section class="kapitel zone-hell" id="fragen">
  <div class="bahn">
    <div class="kapitel__marke">
      <span class="nummer">?</span>
      <span class="kicker">Häufige Fragen</span>
      <span class="regel"></span>
    </div>
    <div class="faq">
      {% for f in c.faq %}
      <details class="auftritt"><summary><span>{{ f.frage }}</span><i aria-hidden="true"></i></summary><p>{{ f.antwort }}</p></details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ------------------------------------------------------------- Kontakt #}
<section class="kontakt zone-kontakt" id="kontakt">
  <div class="bahn">
    <div class="kapitel__marke">
      <span class="nummer">→</span>
      <span class="kicker">Kontakt</span>
      <span class="regel"></span>
    </div>
    <div class="kontakt__raster">
      <h2 class="kontakt__titel auftritt">{{ c.kontakt_text }}</h2>
      <dl class="kontakt__daten auftritt">
        {% if req.kontakt.email %}<div><dt>E-Mail</dt><dd><a href="mailto:{{ req.kontakt.email }}">{{ req.kontakt.email }}</a></dd></div>{% endif %}
        {% if req.kontakt.telefon %}<div><dt>Telefon</dt><dd><a href="tel:{{ tel }}">{{ req.kontakt.telefon }}</a></dd></div>{% endif %}
        {% if req.kontakt.adresse %}<div><dt>Adresse</dt><dd>{{ req.kontakt.adresse }}</dd></div>{% endif %}
        {% if not (req.kontakt.email or req.kontakt.telefon or req.kontakt.adresse) %}<div><dt>Kontakt</dt><dd>Kontaktdaten folgen.</dd></div>{% endif %}
      </dl>
      {% if req.kontakt.email %}<a class="aktion aktion--gross auftritt" href="mailto:{{ req.kontakt.email }}">Nachricht schreiben <span class="pfeil" aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</section>
{% endblock %}

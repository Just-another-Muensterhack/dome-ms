{
  "name": "@dome/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build-intl": "build-intl --force -i ./locales -o ./i18n/translations.ts -n domeTranslation",
    "build": "npm run build-intl && next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint ."
  },
  "browserslist": [
    "> 0.2%",
    "Firefox ESR",
    "not dead",
    "Android >= 5",
    "Safari >= 8",
    "iOS >= 8",
    "defaults"
  ],
  "overrides": {
    "postcss": "8.5.15"
  },
  "dependencies": {
    "@helpwave/hightide": "0.17.2",
    "@helpwave/internationalization": "0.4.0",
    "@tailwindcss/postcss": "4.3.1",
    "@tanstack/react-query": "5.101.0",
    "clsx": "2.1.1",
    "lucide-react": "1.20.0",
    "next": "16.2.9",
    "postcss": "8.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@helpwave/eslint-config": "0.0.11",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.1",
    "postcss-flexbugs-fixes": "5.0.2"
  }
}
